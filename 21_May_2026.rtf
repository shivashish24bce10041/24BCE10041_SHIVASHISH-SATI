\f0\fs24 \cf0 -- on delete cascade. :- When you delete a record from the parent table, all related records in the child table are automatically deleted too. if you\
--   dont give this command (on delete cascade  )then the code to delete the parent table row don't work .\
\
USE vitcampus;\
CREATE TABLE category (\
    cid INT PRIMARY KEY,\
    cname VARCHAR(100) NOT NULL\
);\
\
INSERT INTO category VALUES (101, 'electronics'), (102, 'Home App');\
\
SELECT * FROM category;\
\
DROP TABLE products;\
\
CREATE TABLE products (\
    pid INT PRIMARY KEY,\
    pname VARCHAR(100) NOT NULL,\
    cid INT,\
    FOREIGN KEY (cid) REFERENCES category(cid) ON DELETE CASCADE\
);\
\
DESC products;       \
\
SELECT * FROM category;\
\
DELETE FROM category WHERE cid = 101;  \
