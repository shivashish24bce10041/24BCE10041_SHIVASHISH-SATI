-- order by :- arrange in assending or decending order \
\
select*from worker;\
\
select first_name ,department, salary from worker \
where department='admin' order by salary asc ;\
\
select first_name ,department, salary from worker \
where department='admin' order by salary desc ;\
\
\
-- group by \
select count(worker_id)from worker where department= 'admin ';\
select department, count(department) from worker\
group by department order by department asc;\
\
Select DEPARTMENT,Sum(salary) from worker group by department;\
\
\
\
\
-- Having class\
\
-- print department which have more than three employee \
\
\
select department, count(department) \
from worker \
group by department \
having count(department) >= 3  \
order by department asc;\
\
-- print department which have salary less than 300000\
\
select department, count(department) \
from worker \
group by department \
having sum(salary)< 300000 \
order by department asc;\
\
\
-- Limt class :- limits the output \
\
select*from worker limit 1 offset 3;  -- this print from 1 out put and leave the values till three value \
\
\
\
\
--  sub query \
-- This technique is called a SUBQUERY \'97 a query inside another query \
\
CREATE TABLE toppers (   				-- topper is made as a sub querry for the worker table\
    id INT PRIMARY KEY\
);\
INSERT INTO toppers VALUES (2), (5);\
select*from toppers;\
\
select * from worker limit 2 offset 3;   -- So it skips rows 1,2,3 and shows rows 4 and 5 from worker table\
\
select*from toppers ;\
\
select worker_id, first_name, department from worker   -- toppers table = stores IDs of top workers (2 and 5)\
where worker_id in (select id from toppers);    	-- Subquery = fetch full details of those top workers from the worker table .\
\
-- i want to print first two department individual worker getting least salary \
\
select department, min(salary) as least_salary\
from worker\
group by department\
order by least_salary asc;\
\
--  Q -i want to print first two department all worker salary combined getting least salary \
SELECT department, SUM(salary)\
FROM worker\
GROUP BY department\
ORDER BY SUM(salary) ASC\
LIMIT 2;\
\
\
\
-- Q -in admin department who is getting the second largest salary\
\
select first_name, department, salary from worker\
where department = 'admin' order by salary desc limit 1 offset 1;\
\
\
--  in each department i want to print the second largest salary\
-- w1 ,w2 ,w3 :-  They all point to the same worker table but are used separately in each layer so SQL doesn't get confused \'97 \
-- this is called a correlated subquery because inner queries depend on the outer query's current row (w1.department)\
\
select*from worker ;\
\
select department, first_name, salary\
from worker w1\
where salary = (\
    select max(salary) \
    from worker w2\
    where w2.department = w1.department\
    and salary < (\
        select max(salary) \
        from worker w3\
        where w3.department = w1.department\
    )\
)\
order by department;}